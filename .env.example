# AI API 配置
# 支持多平台：OpenAI、Kimi（Moonshot AI）、硅基流动、阿里云百炼
# 使用哪个平台就填写对应的配置

# === Kimi API (Moonshot AI) - 推荐国内用户 ===
#MOONSHOT_API_KEY=your_moonshot_api_key_here
#MOONSHOT_MODEL=kimi-k2.6
#MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# === 硅基流动 (SiliconFlow) - 提供免费额度 ===
# SILICONFLOW_API_KEY=your_siliconflow_api_key_here
# SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# === 阿里云百炼 (DashScope) - 新用户有免费额度 ===
# DASHSCOPE_API_KEY=your_dashscope_api_key_here
# DASHSCOPE_MODEL=qwen-turbo
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# === OpenAI (如需使用) ===
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-3.5-turbo

# === 智谱AI (BigModel) - 提供免费额度 ===
ZHIPU_API_KEY=036b8c06227240ddb422b86677c0fcc4.16QQGVrAHl5ulPRh
ZHIPU_MODEL=glm-4-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 当前使用的 AI 平台 (kimi/siliconflow/dashscope/openai/zhipu)
AI_PLATFORM=zhipu

# ========== Kafka ==========
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_LOGS_TOPIC=logs_raw
KAFKA_ANALYZED_TOPIC=logs_analyzed
KAFKA_CONSUMER_GROUP=log_analysis_group

# ========== ClickHouse ==========
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=log_analysis
CLICKHOUSE_USER=test_user
CLICKHOUSE_PASSWORD=test_password
CLICKHOUSE_TABLE=logs_structured
# Clickhouse快速执行命令配置
# CREATE DATABASE IF NOT EXISTS log_analysis;
# CREATE USER IF NOT EXISTS your_user_here IDENTIFIED BY 'your_password_here';
# GRANT ALL ON log_analysis.* TO your_user_here;

# Elasticsearch 配置 (可选，如不使用可留空)
ES_HOST=localhost
ES_PORT=9200
ES_INDEX=logs-*
ES_USER=elastic
ES_PASSWORD=your_password_here

# 日志采集配置
LOG_SOURCES_CONFIG=config/log_sources.yml

# 应用配置
LOG_LEVEL=INFO
LOG_OUTPUT_DIR=logs
REPORT_OUTPUT_DIR=reports
DATA_RETENTION_DAYS=90

# ========== Streamlit ==========
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# ========== 行为分析 ==========
BEHAVIOR_TIME_WINDOW_HOURS=24
ANOMALY_THRESHOLD=0.7
MIN_SAMPLES_FOR_PROFILE=10
ANALYSIS_WINDOW_MINUTES=5
ANALYSIS_INTERVAL_SEC=60

# ========== 测试临时目录 ==========
TEST_TMP_DIR=./test_tmp
FILEBEAT_DATA_DIR=./test_tmp/filebeat_data
FILEBEAT_LOGS_DIR=./test_tmp/filebeat_logs
FILEBEAT_CONFIG_DIR=./test_tmp/filebeat_config

# ========== 日志生成速度 ==========
LOG_GEN_INTERVAL_SEC=1
LOGS_PER_BATCH=10