# Docker 镜像配置文件
# 记录本地可用的 Docker 镜像及其来源仓库
# 生成时间: 2026-06-05

# === 日志分析 AI 助手所需镜像 ===

# ClickHouse 数据库（主镜像）
CLICKHOUSE_SERVER_IMAGE=clickhouse/clickhouse-server:latest
CLICKHOUSE_SERVER_REPO=docker.io/clickhouse/clickhouse-server

# ClickHouse 数据库（备用镜像）
CLICKHOUSE_SERVER_YANDEX_IMAGE=yandex/clickhouse-server:latest
CLICKHOUSE_SERVER_YANDEX_REPO=docker.io/yandex/clickhouse-server

# Kafka 消息队列
KAFKA_IMAGE=apache/kafka:3.7.0
KAFKA_REPO=docker.io/apache/kafka

# ZooKeeper 分布式协调
ZOOKEEPER_IMAGE=zookeeper:3.8
ZOOKEEPER_REPO=docker.io/library/zookeeper

# Filebeat 日志采集器
FILEBEAT_IMAGE=docker.elastic.co/beats/filebeat:8.13.0
FILEBEAT_REPO=docker.elastic.co/beats/filebeat

# === 镜像来源说明 ===
# - docker.io/library/xxx: Docker Hub 官方仓库
# - docker.io/xxx/xxx: Docker Hub 用户/组织仓库
# - docker.elastic.co/xxx/xxx: Elastic 官方仓库
